# Aplicación
APP_NAME=PDF Extractext Documents
APP_LOG_LEVEL=INFO
# json para producción (Traefik/agregadores), text para desarrollo local
APP_LOG_FORMAT=json
APP_SHUTDOWN_TIMEOUT_S=10
APP_MAX_PDF_SIZE_BYTES=10485760
APP_MAX_LIST_LIMIT=100
# Nunca dejar el spool ilimitado: se fija al tamaño máximo del PDF.
APP_UPLOAD_SPOOL_MAX_BYTES=10485760
PORT=8000
WEB_CONCURRENCY=1

# Seguridad (el orquestador inyecta los valores reales desde secretos)
# Si APP_API_KEY está vacía NO hay autenticación a nivel de aplicación.
APP_API_KEY=
APP_RATE_LIMIT_PER_MINUTE=120
APP_DOCS_ENABLED=false
APP_DISABLE_DOTENV=0

# Credenciales locales del compose de desarrollo (cambiar fuera de local)
MONGO_INITDB_ROOT_USERNAME=documents
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Base de datos (este servicio es el único dueño de MongoDB en el poly repo)
# En producción usar tls=true y secretos, nunca credenciales en el repo.
MONGODB_URI=mongodb://documents:CHANGE_ME@mongodb:27017/?authSource=admin
MONGODB_DB_NAME=pdf-extractext
MONGO_COLLECTION_NAME=documents
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# Servicio de extracción (propio del poly repo, detrás de Traefik)
# En producción: https://... (TLS/mTLS detrás de Traefik), nunca http://
EXTRACT_SERVICE_URL=http://extract:8001
EXTRACT_TIMEOUT_S=30
EXTRACT_MAX_ATTEMPTS=3
EXTRACT_RETRY_BASE_DELAY_S=0.2
EXTRACT_RETRY_MAX_DELAY_S=2.0
EXTRACT_MAX_CONCURRENCY=20

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_S=30

# Caché: REDIS_URL vacía => caché en memoria (sólo recomendado para 1 worker)
# En producción: rediss://:password@redis:6379/0 (TLS)
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
CACHE_KEY_PREFIX=pdf-documents
CACHE_TTL_S=300
CACHE_MAX_ENTRIES=1000

# Saga de upload
SAGA_OWNER_ID=
SAGA_LOCK_TTL_S=120
SAGA_CLAIM_WAIT_S=2.0
SAGA_RECOVERY_INTERVAL_S=60
SAGA_RECOVERY_BATCH_SIZE=20
